// AI-Powered Fitness Coach — Prisma schema (SQLite)
// Isolated database: db/custom.db (configured via .env / package.json db:* scripts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id              String   @id @default(cuid())
  name            String
  goals           String
  equipment       String
  timePerSessionMin Int
  daysPerWeek     Int
  recoveryState   String   @default("fresh")
  experienceLevel String   @default("intermediate")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workouts        Workout[]
}

model Workout {
  id              String   @id @default(cuid())
  profileId       String
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  blocksJson      String
  totalVolumeLb   Int
  totalDurationMin Int
  completed       Boolean  @default(false)
  rpe             Int?

  @@index([profileId])
}

model FormCheck {
  id            String   @id @default(cuid())
  workoutId     String?
  exerciseName  String
  mediaPath     String?
  analysis      String?
  errorsDetected String?
  createdAt     DateTime @default(now())
}
